// Maestro 插件接口合同（单一来源：宿主 bindgen! 与插件 crate 共用，见 issue #34）。
// Provider 领域模型焊进接口版本：加字段/加协议 = 升级包版本 + 插件重编译。
package maestro:plugin@1.1.0;

/// 宿主桥接目标工具的系统凭证库。
///
/// 插件经此把凭证写入目标工具自己的钥匙串条目：条目落在 manifest 声明的
/// `keychain_namespace`（目标工具自己的 service 名）下，`key` 是工具侧索引键、
/// `secret` 是凭证明文。插件自身声明 `keychain_namespace` 才允许调用；未声明时
/// 调用即报错。
interface keychain {
    /// 写入一条凭证；key 是工具侧索引键（如 Zed 按 API 端点 URL 精确匹配条目），
    /// 同 key 重复写入为覆盖，不做冲突报错。
    write: func(key: string, secret: string) -> result<_, string>;

    /// 删除一条凭证；key 不存在视为成功（幂等）。
    delete: func(key: string) -> result<_, string>;
}

interface plugin {
    /// 把一批单协议 Provider 投影进工具配置目录。
    ///
    /// 返回已写入文件的路径列表（相对 config_dir）；错误为人类可读描述。
    write-providers: func(providers: list<provider>) -> result<list<string>, string>;

    /// 单协议 Provider：宿主侧取唯一非空的协议槽位，
    /// 零个或两个非空 → 该 Provider 不进入本列表（跳过原因在投影结果中报告）。
    record provider {
        slug: string,
        protocol: protocol,
        base-url: string,
        /// 凭证可有可无；空串由宿主归一化为 none。
        api-key: option<string>,
        models: list<model>,
    }

    enum protocol {
        openai-completions,
        anthropic-messages,
    }

    record model {
        id: string,
        display-name: option<string>,
    }
}

/// 插件组件导出的世界：插件在 WASI 0.2 下运行，
/// 宿主把 manifest 声明的 config_dir 预开放为 "/"，插件经 WASI 直接落盘。
/// 凭证桥接经 `keychain` import 走宿主（沙箱无法访问系统凭证库）。
world plugin-world {
    import keychain;
    export plugin;
}
