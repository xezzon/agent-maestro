// Maestro 插件接口合同（单一来源：宿主 bindgen! 与插件 crate 共用，见 issue #34）。
// Provider 领域模型焊进接口版本：加字段/加协议 = 升级包版本 + 插件重编译。
package maestro:plugin@2.1.0;

/// 插件过程性日志（issue #82）：投影期间插件可向用户外显非致命事件
/// （逐条容错跳过、降级提示等）。宿主把每条消息按 level 写入应用日志
/// （error→ERROR、warning→WARN、info→INFO、debug→DEBUG），不进投影结果；
/// level 只决定消息在应用日志中的严重级。
interface logger {
    enum level { error, warning, info, debug }

    /// 记录一条插件日志。message 仅供应用日志记录，不得携带
    /// API Key 等凭证（宿主不做内容审查，约束见本 crate 的 README）。
    log: func(level: level, message: string);
}

/// 插件配置（ADR 0018）：宿主在实例化之前把插件配置中 `form` 段的原始
/// JSON 文本就位，组件在 init 与 write-providers 之前均可读取。
interface config {
    /// 读取插件配置的 `form` 段（原始 JSON 文本，由插件自行解析）；
    /// 配置缺省或无该段时返回 none。
    get-config: func() -> option<string>;
}

interface plugin {
    /// 把一批 Provider 投影进工具配置目录。
    ///
    /// Provider 携带其全部已配置端点与界面所选协议；由插件决定投影使用哪个
    /// 端点（见 ADR 0016）。宿主只做映射：零端点的 Provider 不进入本列表
    /// （跳过原因在投影结果中报告）。
    ///
    /// 返回已写入文件的路径列表（相对 config_dir）；错误为人类可读描述。
    write-providers: func(providers: list<provider>) -> result<list<string>, string>;

    /// 一条 Provider：可同时携带两种协议的端点。
    record provider {
        slug: string,
        /// 已配置的端点，每个协议至多一个；宿主按固定顺序（openai-completions
        /// 在前）收集非空槽位，空串不计入。
        endpoints: list<endpoint>,
        /// 界面记录的投影选择；缺失（旧配置未记录）或指向未配置的协议时，
        /// 由插件按自身兜底规则决定投影端点（见 ADR 0016）。
        selected-protocol: option<protocol>,
        /// 凭证可有可无；空串由宿主归一化为 none。
        api-key: option<string>,
        models: list<model>,
    }

    /// 单协议端点：一个协议对应一个 Base URL。
    record endpoint {
        protocol: protocol,
        base-url: string,
    }

    enum protocol {
        openai-completions,
        anthropic-messages,
    }

    record model {
        id: string,
        display-name: option<string>,
    }
}

/// 插件组件导出的世界：插件在 WASI 0.2 下运行，
/// 宿主把 manifest 声明的 config_dir 预开放为 "/"，插件经 WASI 直接落盘。
///
/// logger 是宿主恒定提供的 import（见 ADR 0013）：组件不引用即不受影响。
/// WIT 包版本升级（如 1.1.0 → 2.0.0）要求插件以新版 SDK 重编译——宿主只注册
/// 当前版本的导出，不同时兼容旧版合同的组件。
world plugin-world {
    import logger;
    import config;
    export plugin;
}
